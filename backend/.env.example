# Copy to backend/.env and fill in. NEVER commit backend/.env.

# Primary API key from https://developer.nationaltransport.ie (GTFS-Realtime v2 product).
NTA_API_KEY=your_nta_primary_api_key_here

# GTFS-R v2 TripUpdates endpoint (Protocol Buffers).
# NOTE: double-check the exact URL in the NTA Developer Portal.
NTA_GTFSR_URL=https://api.nationaltransport.ie/gtfsr/v2/TripUpdates

# Combined GTFS Static archive.
# NOTE: confirm the latest URL on transportforireland.ie / data.gov.ie.
NTA_GTFS_STATIC_URL=https://www.transportforireland.ie/transitData/Data/GTFS_Realtime.zip

REDIS_URL=redis://localhost:6379/0
SQLITE_DB_PATH=data/gtfs.db

# A familiar stop_id (find it with: python scripts/fetch_static_gtfs.py --search "Maynooth").
TEST_STOP_ID=

# --- Phase 2: backend proxy ---
# Optional shared secret protecting /stops/*. Leave empty to disable auth (local dev).
# When set, clients must send the header:  X-API-Key: <APP_API_KEY>   (/health stays open)
APP_API_KEY=

# Freshness of the cached GTFS-R feed in Redis (seconds) and NTA fetch timeout.
GTFSR_TTL_SECONDS=60
GTFSR_REQUEST_TIMEOUT_SECONDS=10

# Defaults for GET /stops/{stop}/departures.
DEFAULT_WINDOW_MINUTES=90
DEFAULT_DEPARTURES_LIMIT=10

# In-app daily GTFS Static refresh (compose.yaml turns this on for the api container).
STATIC_REFRESH_ENABLED=false
STATIC_REFRESH_HOUR_UTC=4

TIMEZONE=Europe/Dublin
